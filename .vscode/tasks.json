{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "配置 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "编译 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置 Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "烧录 Debug（J-Link）",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f",
                "interface/jlink.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "program \"build/Debug/wdr_xrobot_dmmc02_framework.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "编译 Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "配置 Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "编译 Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置 Release",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "烧录 Release（J-Link）",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f",
                "interface/jlink.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "program \"build/Release/wdr_xrobot_dmmc02_framework.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "编译 Release",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "检查外接模块（仅编译）",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "external_module_checks",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置 Debug",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "测试 i6x 输入（主机）",
            "type": "process",
            "command": "python3",
            "args": [
                "tests/i6x/run_tests.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "测试 IMU（主机）",
            "type": "process",
            "command": "python3",
            "args": [
                "tests/imu/run_tests.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "测试底盘（主机）",
            "type": "process",
            "command": "python3",
            "args": [
                "tests/chassis/run_tests.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "烧录 Debug（DAPLink）",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f",
                "interface/cmsis-dap.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "program \"build/Debug/wdr_xrobot_dmmc02_framework.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "编译 Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "烧录 Release（DAPLink）",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f",
                "interface/cmsis-dap.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "program \"build/Release/wdr_xrobot_dmmc02_framework.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "编译 Release",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "测试公共控制算法（主机）",
            "type": "process",
            "command": "python3",
            "args": [
                "tests/control_algorithms/run_tests.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
