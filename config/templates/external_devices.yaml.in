# 待填写模板，不参与默认启动。null 按真实型号、ID、方向、接线填写。
modules:
- module: YunMo-yanyu/CMD
  id: cmd
  args:
  - mode: CMD::Mode::CMD_OP_CTRL
  - chassis_cmd_topic_name: '"chassis_cmd"'
  - gimbal_cmd_topic_name: '"gimbal_cmd"'
  - launcher_cmd_topic_name: '"launcher_cmd"'
- module: YunMo-yanyu/RMMotor
  id: rmmotor
  args:
  - can_bus: null
  - param:
      model: null
      reverse: null
      feedback_id: null
- module: YunMo-yanyu/DMMotor
  id: dmmotor
  args:
  - can_bus: null
  - param:
      model: null
      reverse: null
      can_id: null
- module: YunMo-yanyu/DR16
  id: dr16
  args:
  - uart: null
  - cmd: cmd
  - param:
      task_stack_depth_uart: 2048
      thread_priority_uart: LibXR::Thread::Priority::HIGH
      chassis:
        speed_x: 2.64
        speed_y: 2.64
        spin: 12.0
        deadband: 0.01515151515
- module: YunMo-yanyu/Referee
  id: referee
  args:
  - uart: null
  - cmd: nullptr
  - param:
      task_stack_depth_uart: 2048
      baudrate: 115200
      referee_chassis_tp_name: '"chassis_ref"'
      referee_launcher_tp_name: '"launcher_ref"'
      referee_robot_game_tp_name: '"robot_game_ref"'
      referee_radar_tp_name: '"radar_ref"'
      thread_priority_uart: LibXR::Thread::Priority::MEDIUM
      chassis:
        speed_x: 2.64
        speed_y: 2.64
        spin: 12.0
        deadband: 0.01515151515
      referee_power_tp_name: '"chassis_power_ref"'
- module: YunMo-yanyu/HostData
  id: hostdata
  args:
  - cmd: cmd
  - host_gimbal_topic_name: '"target_euler"'
  - host_chassis_data_topic_name: '"host_chassis_data"'
  - host_fire_topic_name: '"host_fire_notify"'
- module: xrobot-org/SharedTopic
  id: host_rx
  args:
  - uart: null
  - ramfs: ramfs
  - uart_name: '"host"'
  - buffer_size: 256
  - topic_configs: '{"target_euler", "host_chassis_data", "host_fire_notify"}'
- module: xrobot-org/SharedTopicClient
  id: host_tx
  args:
  - uart: null
  - slot_count: 16
  - topic_configs: '{"bmi088_gyro", "bmi088_accl"}'
settings:
  monitor_sleep_ms: 1000
