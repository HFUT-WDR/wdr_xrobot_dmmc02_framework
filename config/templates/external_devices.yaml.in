# 待填写模板，不参与默认启动。null 按真实型号、ID、方向、接线填写。
modules:
- module: HFUT-WDR/CMD
  id: cmd
  args:
  - mode: CMD::Mode::CMD_OP_CTRL
  - chassis_cmd_topic_name: '"chassis_cmd"'
  - gimbal_cmd_topic_name: '"gimbal_cmd"'
  - launcher_cmd_topic_name: '"launcher_cmd"'
  - auto_chassis_wz_source: CMD::ChassisWzSource::HOST
- module: HFUT-WDR/RMMotor
  id: rmmotor
  args:
  - can_bus: null
  - param:
      model: null
      reverse: null
      feedback_id: null
      gm6020_mode: RMMotor::Gm6020Mode::CURRENT
- module: HFUT-WDR/DMMotor
  id: dmmotor
  args:
  - can_bus: null
  - param:
      model: null
      reverse: null
      can_id: null
      position_max: 0
- module: HFUT-WDR/DR16
  id: dr16
  args:
  - uart: usb_otg_hs_cdc2
  - cmd: cmd
  - param:
      task_stack_depth_uart: 2048
      thread_priority_uart: LibXR::Thread::Priority::HIGH
      chassis:
        speed_x: 2.64
        speed_y: 2.64
        spin: 12.0
        deadband: 0.01515151515
- module: HFUT-WDR/Referee
  id: referee
  args:
  - uart: usb_otg_hs_cdc2
  - cmd: nullptr
  - param:
      task_stack_depth_uart: 2048
      baudrate: 115200
      referee_chassis_tp_name: '"chassis_ref"'
      referee_launcher_tp_name: '"launcher_ref"'
      referee_robot_game_tp_name: '"robot_game_ref"'
      referee_radar_tp_name: '"radar_ref"'
      thread_priority_uart: LibXR::Thread::Priority::MEDIUM
      chassis:
        speed_x: 2.64
        speed_y: 2.64
        spin: 12.0
        deadband: 0.01515151515
      referee_power_tp_name: '"chassis_power_ref"'
- module: HFUT-WDR/HostData
  id: hostdata
  args:
  - cmd: cmd
  - host_gimbal_topic_name: '"target_euler"'
  - host_chassis_data_topic_name: '"host_chassis_data"'
  - host_fire_topic_name: '"host_fire_notify"'
  - host_gimbal_command_topic_name: '"host_gimbal_command"'
  - telemetry: true
- module: xrobot-org/SharedTopic
  id: host_rx
  args:
  - uart: usb_otg_hs_cdc2
  - ramfs: ramfs
  - uart_name: '"host"'
  - buffer_size: 256
  - topic_configs: '{"host_aim", "host_nav", "host_time_sync"}'
- module: xrobot-org/SharedTopicClient
  id: host_tx
  args:
  - uart: usb_otg_hs_cdc2
  - slot_count: 16
  - topic_configs: '{"robot_aim_state", "robot_nav_state", "robot_time_sync"}'
settings:
  monitor_sleep_ms: 1000
