-          normal_state: 0
-      - referee_power_topic_name: "chassis_power_ref"
+      - param:
+          control:
+            enabled: true
+            rls_enabled: true
+            torque_coefficient: 1.90484e-05
+            k1: 0.0147
+            k2: 476.3
