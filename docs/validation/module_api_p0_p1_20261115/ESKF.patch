+// 独立解析解：零角速、无重力校正的一步预测，验证dt、dt²和dt³项均按实际步长变化。
+static void measured_step_covariance()
+{
+  for (float dt : {.0006f, .002f, .01f})
+  {
+    Config config;
+    config.initialization_samples = 2;
+    Filter f(config);
+    Sample sample;
+    sample.accel = Vec3(0, 0, GRAVITY);
+    feed(f, sample, 2);
+    assert(f.GetState().initialized);
+    sample.accel.setZero();
+    sample.time_us += static_cast<uint64_t>(std::lround(dt * 1e6f));
+    assert(f.Update(sample, dt));
+    const float gyro_var = config.gyro_noise_density * config.gyro_noise_density;
+    const float bias_var = config.bias_random_walk * config.bias_random_walk;
+    const auto& p = f.GetCovariance();
+    for (unsigned axis = 0; axis < 3; ++axis)
+    {
+      assert(std::abs(p(axis, axis) -
+                      (.01f + .0004f * dt * dt + gyro_var * dt +
+                       bias_var * dt * dt * dt / 3)) < 2e-9f);
+      assert(std::abs(p(axis, axis + 3) -
+                      (-.0004f * dt - .5f * bias_var * dt * dt)) < 1e-10f);
+      assert(std::abs(p(axis + 3, axis + 3) - (.0004f + bias_var * dt)) < 1e-10f);
+    }
